---
import { papers } from '../data/papers';
import Icon from './Icon.astro';

const linkIcon: Record<string, string> = {
  Paper: 'paper',
  Code: 'github',
  Docs: 'book',
  PyPI: 'package',
};

const defaultId = papers[papers.length - 1].id;
const awardCount = papers.filter((p) => p.award).length;
---

<div class="pub-grid">
  <div class="pub-index-col">
    <div class="pub-head mono-label" aria-hidden="true">
      <span>Year</span>
      <span>Venue</span>
      <span>Paper</span>
      <span></span>
    </div>
    <div class="pub-index" role="tablist" aria-label="Publications">
      {papers.map((p) => (
        <button
          type="button"
          role="tab"
          id={`tab-${p.id}`}
          aria-controls={`panel-${p.id}`}
          aria-selected={p.id === defaultId ? 'true' : 'false'}
          tabindex={p.id === defaultId ? '0' : '-1'}
          data-paper={p.id}
          class="pub-row"
        >
          <span class="pub-year">{p.year}</span>
          <span class="pub-venue mono-label">
            {p.venueTag}
            {p.award && <Icon name="award" size={11} class="pub-award" />}
          </span>
          <span class="pub-title">{p.short}</span>
          <Icon name="chevron" size={14} class="pub-go" />
        </button>
      ))}
    </div>

    <div class="pub-stats">
      <div class="pub-stat">
        <div class="display text-lg">{papers.length}</div>
        <div class="mono-label mt-0.5 text-ink3">papers</div>
      </div>
      <div class="pub-stat">
        <div class="display text-lg text-warmink">{awardCount}</div>
        <div class="mono-label mt-0.5 text-ink3">best paper</div>
      </div>
    </div>
    <p class="pub-hint mono-label text-ink3">Select a row to open its record</p>
  </div>

  <div class="pub-detail-col">
    {papers.map((p) => (
      <div
        role="tabpanel"
        id={`panel-${p.id}`}
        aria-labelledby={`tab-${p.id}`}
        data-panel={p.id}
        class={`pub-panel${p.id === defaultId ? ' is-active' : ''}`}
      >
        <div class="flex flex-wrap items-center gap-3">
          <span class="mono-label border border-rulestrong px-2 py-1 text-ink2">{p.venueTag}</span>
          {p.award && (
            <span class="mono-label inline-flex items-center gap-1.5 text-warmink">
              <Icon name="award" size={12} />{p.award}
            </span>
          )}
        </div>
        <h3 class="display mt-3 text-[19px] leading-snug">{p.title}</h3>
        <p class="mt-3 text-[14.5px] text-ink2">{p.contribution}</p>
        <p class="mt-2 text-[12.5px] text-ink3">{p.authors}</p>
        <div class="mt-3.5 flex flex-wrap gap-x-5 gap-y-1.5">
          {p.links.map((l) => (
            <a class="link" href={l.href} target="_blank" rel="noopener">
              <Icon name={linkIcon[l.label] ?? 'external'} size={12} />{l.label}
            </a>
          ))}
        </div>

        {p.figure && (
          <figure class="paper-fig">
            <div class="fig-matte">
              <img
                src={`${import.meta.env.BASE_URL}figures/${p.figure.src}`}
                alt={p.figure.caption}
                loading="lazy"
                decoding="async"
                width={p.figure.w}
                height={p.figure.h}
              />
            </div>
            <figcaption>
              <span class="mono-label text-signalink">{p.figure.fig}</span>
              <span class="text-ink3">{p.figure.caption}</span>
            </figcaption>
          </figure>
        )}

        <details class="bib">
          <summary>
            <span class="bib-label">BibTeX</span>
            <button
              class="copy-btn mono-label inline-flex cursor-pointer items-center gap-1.5 border border-rulestrong px-2 py-1 text-ink2 transition-colors hover:border-signal hover:text-signalink"
              data-copy={p.bibtex}
              type="button"
            >
              <Icon name="copy" size={12} class="ic-copy" /><Icon name="check" size={12} class="ic-check" /><span class="lbl">Copy</span>
            </button>
          </summary>
          <pre>{p.bibtex}</pre>
        </details>
      </div>
    ))}
  </div>
</div>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-paper]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"][data-panel]')];

  const activate = (id: string, scroll = false) => {
    tabs.forEach((t) => {
      const on = t.dataset.paper === id;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === id));
    if (scroll) {
      const panel = document.getElementById(`panel-${id}`);
      if (panel) {
        const r = panel.getBoundingClientRect();
        if (r.top > window.innerHeight * 0.72 || r.bottom < 96) {
          panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }
  };

  tabs.forEach((t) => {
    t.addEventListener('click', () => activate(t.dataset.paper!, true));
    t.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(t);
      let next = -1;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      if (e.key === 'Home') next = 0;
      if (e.key === 'End') next = tabs.length - 1;
      if (next >= 0) {
        e.preventDefault();
        tabs[next].focus();
        activate(tabs[next].dataset.paper!, true);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      if (btn.closest('summary')) {
        e.preventDefault();
        e.stopPropagation();
      }
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      const lbl = btn.querySelector('.lbl');
      const prev = lbl?.textContent ?? 'Copy';
      if (lbl) lbl.textContent = 'Copied';
      btn.classList.add('copied');
      setTimeout(() => { if (lbl) lbl.textContent = prev; btn.classList.remove('copied'); }, 1400);
    });
  });
</script>

<style>
  .pub-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .pub-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      align-items: start;
    }

    .pub-index-col {
      position: sticky;
      top: 4.75rem;
    }

    .pub-detail-col {
      border-left: 1px solid var(--rule);
      padding-left: 2rem;
    }
  }

  .pub-head {
    display: grid;
    grid-template-columns: 3.4rem 6.4rem minmax(0, 1fr) 1.25rem;
    gap: 0.75rem;
    padding: 0 0.75rem 0.4rem;
    color: var(--ink-3);
    border-bottom: 1px solid var(--rule-strong);
  }

  .pub-index {
    border-bottom: 1px solid var(--rule);
  }

  .pub-row {
    display: grid;
    grid-template-columns: 3.4rem 6.4rem minmax(0, 1fr) 1.25rem;
    gap: 0.75rem;
    align-items: center;
    width: 100%;
    text-align: left;
    padding: 0.85rem 0.75rem;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--rule);
    border-left: 2px solid transparent;
    cursor: pointer;
    transition: background-color 160ms ease, border-left-color 160ms ease;
  }

  .pub-row:last-child {
    border-bottom: none;
  }

  .pub-row:hover {
    background: var(--signal-soft);
  }

  .pub-row[aria-selected='true'] {
    background: var(--signal-soft);
    border-left-color: var(--signal);
  }

  .pub-year {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    transition: color 160ms ease;
  }

  .pub-row[aria-selected='true'] .pub-year {
    color: var(--signal-ink);
  }

  .pub-venue {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .pub-award {
    color: var(--warm-ink);
    flex-shrink: 0;
  }

  .pub-title {
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 160ms ease;
  }

  .pub-row:hover .pub-title,
  .pub-row[aria-selected='true'] .pub-title {
    color: var(--ink);
  }

  .pub-go {
    color: var(--ink-3);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 160ms ease, transform 160ms ease, color 160ms ease;
  }

  .pub-row:hover .pub-go,
  .pub-row[aria-selected='true'] .pub-go {
    opacity: 1;
    transform: translateX(0);
  }

  .pub-row[aria-selected='true'] .pub-go {
    color: var(--signal-ink);
  }

  @media (max-width: 640px) {
    .pub-head,
    .pub-row {
      grid-template-columns: 3rem minmax(0, 1fr) 1rem;
      gap: 0.5rem;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }

    .pub-head span:nth-child(2) {
      display: none;
    }

    .pub-venue {
      display: none;
    }

    .pub-title {
      font-size: 13px;
    }
  }

  .pub-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule-strong);
    border: 1px solid var(--rule-strong);
    margin-top: 1.5rem;
  }

  .pub-stat {
    background: var(--plate);
    padding: 0.8rem 0.9rem;
  }

  .pub-hint {
    margin-top: 0.85rem;
    padding-left: 0.15rem;
  }

  .pub-panel {
    display: none;
  }

  .pub-panel.is-active {
    display: block;
    animation: panel-in 240ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  html:not(.js) .pub-panel {
    display: block;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  html:not(.js) .pub-panel + .pub-panel {
    margin-top: 1.75rem;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pub-panel.is-active {
      animation: none;
    }
  }

  .paper-fig {
    margin-top: 1.25rem;
    border: 1px solid var(--rule);
    background: var(--plate);
    padding: 8px;
  }

  .fig-matte {
    background: #fff;
    padding: 8px;
  }

  .paper-fig img {
    display: block;
    width: 100%;
    height: auto;
  }

  .paper-fig figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 2px 2px;
    font-size: 12px;
    line-height: 1.5;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule-strong);
    transition: text-decoration-color 180ms ease;
  }

  .link:hover {
    text-decoration-color: var(--signal);
  }

  .bib {
    margin-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }

  .bib summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 2px;
    cursor: pointer;
    list-style: none;
  }

  .bib summary::-webkit-details-marker {
    display: none;
  }

  .bib-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color 160ms ease;
  }

  .bib summary:hover .bib-label,
  .bib[open] .bib-label {
    color: var(--signal-ink);
  }

  .bib pre {
    padding: 4px 2px 14px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
